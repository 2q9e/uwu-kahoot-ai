{
  "manifest_version": 3,
  "version": "4.2.0",
  "name": "UwU Kahoot AI",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "UwU Kahoot AI v4.2.0"
  },
  "options_ui": {
    "page": "pages/dashboard.html",
    "open_in_tab": true
  },
  "commands": {
    "manual-answer": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Manually trigger answer detection"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.kahoot.it/*",
        "https://play.blooket.com/*"
      ],
      "css": [
        "styles/content.css"
      ],
      "js": [
        "scripts/content/matching.js",
        "scripts/content/dom-adapter.js",
        "scripts/content/blooket-adapter.js",
        "scripts/content/answer-feedback-ui.js",
        "scripts/content/dom-wait.js",
        "scripts/content/question-dom.js",
        "scripts/content/answer-delay-ui.js",
        "scripts/content/answer-choice-actions.js",
        "scripts/content/answer-pin-actions.js",
        "scripts/content/answer-jumble-actions.js",
        "scripts/content/answer-text-slider-actions.js",
        "scripts/content/answer-actions.js",
        "scripts/content/status-ui.js",
        "scripts/content/question-preparation.js",
        "scripts/content/runtime-message-handler.js",
        "scripts/content/controller.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/content/page-bridge.js"
      ],
      "matches": [
        "*://*.kahoot.it/*"
      ]
    }
  ],
  "background": {
    "service_worker": "scripts/background/service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://*.kahoot.it/*",
    "https://play.blooket.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "description": "A private AI quiz companion with Gemini, OpenRouter, and local answer stats. Not affiliated with Kahoot! or Blooket."
}
